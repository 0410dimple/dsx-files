* Tokens were replaced below as follows:
* JobParam%%1 <= jobParamFile
* JobParam%%2 <= CNum
* JobParam%%3 <= Par1
* JobParam%%4 <= tmpDir
* Pin%%V0S46P1.Column%%1 <= inTempFile.TEXT
* GET.Pin%%V0S46P1 <= GET.inTempFile
* Pin%%V0S46P1.REJECTEDCODE <= inTempFile.REJECTEDCODE
* Pin%%V0S46P2.Column%%1 <= outJobParam.OUTPUT1
* PUT.Pin%%V0S46P2 <= PUT.outJobParam
* Pin%%V0S46P2.REJECTED <= outJobParam.REJECTED
* Pin%%V0S46P2.REJECTEDCODE <= outJobParam.REJECTEDCODE
*
* Subroutine for active stage lodcpyCapManAdjTempToJobParamM.t1xfmMapping generated at 08:36:52 24 JUL 2025
*
SUBROUTINE DSTransformerStage(HANDLES,ERROR)

$INCLUDE DSINCLUDE DSD_RTCONFIG.H
$INCLUDE DSINCLUDE DSD_STAGE.H
$INCLUDE DSINCLUDE DSD_BCI.H

$DEFINE JobParam%%1 STAGECOM.JOB.STATUS<7,1>
$DEFINE JobParam%%2 STAGECOM.JOB.STATUS<7,2>
$DEFINE JobParam%%3 STAGECOM.JOB.STATUS<7,3>
$DEFINE JobParam%%4 STAGECOM.JOB.STATUS<7,4>

$INCLUDE DSINCLUDE JOBCONTROL.H
DEFFUN DSRLoadString(Num,Text,Args) CALLING '*DataStage*DSR_LOADSTRING'
$DEFINE Pin%%V0S46P1.Column%%1 STAGECOM.ARR(1)
$DEFINE GET.Pin%%V0S46P1 CALL $DS.SEQGETNEXT(1,Pin%%V0S46P1.REJECTEDCODE)
IF STAGECOM.TRACE.STATS THEN CALL $PERF.NAME(-2,'outJobParam.Derivation')
$DEFINE Pin%%V0S46P2.Column%%1 STAGECOM.ARR(1)
$DEFINE PUT.Pin%%V0S46P2 CALL $DS.SEQPUT(2, Pin%%V0S46P2.REJECTEDCODE)

UPDATE.COUNT = STAGECOM.RATE



LOOP
	REJECTED = @TRUE
	* Get next row from primary input pin inTempFile
	STAGECOM.PINNO = 1
	GET.Pin%%V0S46P1
	ERROR = Pin%%V0S46P1.REJECTEDCODE
WHILE NOT(ERROR)

	STAGECOM.PINNO = 2
	    IF STAGECOM.TRACE.STATS THEN CALL $PERF.BEGIN(-2)
	    IF @TRUE THEN
		* Column derivation code for pin outJobParam
		Pin%%V0S46P2.REJECTED = @FALSE
	    IF STAGECOM.TRACE.STATS THEN CALL $PERF.END(-2)

		PUT.Pin%%V0S46P2
		IF NOT(Pin%%V0S46P2.REJECTEDCODE) THEN
		    REJECTED = @FALSE
		END ELSE 
		    Pin%%V0S46P2.REJECTED = @TRUE
		END 
	    END
	    ELSE
		Pin%%V0S46P2.REJECTED = @TRUE
		Pin%%V0S46P2.REJECTEDCODE = 0
	    END


  UPDATE.COUNT -= 1
  IF UPDATE.COUNT LE 0 THEN CALL DSD.Update(HANDLES);UPDATE.COUNT = STAGECOM.RATE
REPEAT
RETURN
END

